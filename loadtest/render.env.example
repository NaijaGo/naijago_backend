# NEW, separate Render web service only. Never paste into the live backend.
# Name: naijago-loadtest (Render may add a suffix to its public hostname).
NODE_ENV=production
LOAD_TEST_MODE=browse-only
KORAPAY_PAYOUTS_ENABLED=false
# Generate independent random secrets in Render; do not reuse production values.
JWT_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
LOAD_TEST_ACCESS_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Separate cluster/instance. Explicit database name is enforced.
# This user must have ONLY MongoDB's built-in read role on naijago_loadtest.
MONGO_URI=mongodb+srv://READ_ONLY_USER:REPLACE_PASSWORD@REPLACE_STAGING_HOST/naijago_loadtest?retryWrites=true&w=majority
# Do not copy any live integration keys or link production environment groups.
